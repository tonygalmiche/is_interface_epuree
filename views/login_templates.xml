<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pied de page « Gérer les bases » et « Généré par Odoo » toujours masqué (affichage seulement : le gestionnaire
         de bases reste réglé par list_db) -->
    <template id="login_layout" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('border-top')]" position="replace"/>
    </template>

    <!-- Bouton « Se connecter en superutilisateur » (mode développeur) supprimé -->
    <template id="login" inherit_id="web.login">
        <xpath expr="//t[@t-if='debug'][button[@name='redirect']]" position="replace"/>
    </template>
</odoo>
